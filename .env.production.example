# ==============================================================================
# NEARBY CHAT — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env in production: cp .env.production.example .env
# ==============================================================================

# Core Django Secrets
DJANGO_SETTINGS_MODULE=nearby_chat.settings.production
DJANGO_SECRET_KEY=generate_a_secure_50_char_random_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=nearbychat.in,www.nearbychat.in,127.0.0.1,.onrender.com

# Reverse Proxy & SSL (Render, Nginx, Cloudflare)
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://nearbychat.in,https://www.nearbychat.in,https://*.onrender.com

# PostgreSQL Database (Render / Docker)
# If using Render, DATABASE_URL is automatically provided
DATABASE_URL=
DB_NAME=nearby_chat_prod
DB_USER=nearby_chat_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# Redis Cache & WebSockets (Channel Layers)
USE_REDIS=True
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# REAL EMAIL OTP PROVIDER (Brevo REST API v3)
# Authenticated Domain: nearbychat.in
# ==============================================================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@nearbychat.in
BREVO_SENDER_NAME=Nearby Chat

# ==============================================================================
# REAL SMS OTP PROVIDER (Fast2SMS for India / Twilio for Global)
# ==============================================================================
OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=
OTP_EXPIRY_MINUTES=10
