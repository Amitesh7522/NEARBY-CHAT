# ==============================================================================
# NEARBY CHAT — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env in production: cp .env.production.example .env
# ==============================================================================

# Core Django Secrets
DJANGO_SETTINGS_MODULE=nearby_chat.settings.production
DJANGO_SECRET_KEY=generate_a_secure_50_char_random_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1

# PostgreSQL Database
DB_NAME=nearby_chat_prod
DB_USER=nearby_chat_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=db
DB_PORT=5432

# Redis Cache & Channel Layers
USE_REDIS=True
REDIS_URL=redis://redis:6379/0

# HTTPS & Security Hardening
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# OTP & SMS Gateway (MSG91 / Fast2SMS / Twilio)
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=10
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=nearbychat.support@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=Nearby Chat <nearbychat.support@gmail.com>
