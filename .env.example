# ==============================================================================
# NEARBY CHAT — ENVIRONMENT CONFIGURATION TEMPLATE
# For local development: copy to .env
# For Railway / Cloud deployment: configure these variables in the service dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Production: nearby_chat.settings.production | Development: nearby_chat.settings.development
DJANGO_SETTINGS_MODULE=nearby_chat.settings.production

# Generate a unique 50+ character random string in production
DJANGO_SECRET_KEY=change-to-a-cryptographically-secure-random-key-in-production-2026

# Must ALWAYS be False in production
DJANGO_DEBUG=False

# Comma-separated list of host/domain names this site can serve
DJANGO_ALLOWED_HOSTS=nearbychat.in,www.nearbychat.in,.railway.app,.up.railway.app,localhost,127.0.0.1

# Comma-separated list of origins trusted for CSRF and WebSocket connections
CSRF_TRUSTED_ORIGINS=https://nearbychat.in,https://www.nearbychat.in,https://*.railway.app,https://*.up.railway.app

# Reverse Proxy & SSL enforcement (Set True for HTTPS environments)
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# On Railway, DATABASE_URL or DATABASE_PRIVATE_URL is provided automatically when
# attaching the PostgreSQL plugin.
DATABASE_URL=postgresql://user:password@hostname:5432/database_name

# Alternatively, configure individual parameters:
# DB_NAME=nearby_chat_prod
# DB_USER=postgres
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. REAL-TIME CHANNEL LAYER & CACHE (Redis)
# ------------------------------------------------------------------------------
# Enable Redis channel layer for real-time WebSocket messaging across Daphne workers
USE_REDIS=True

# On Railway, REDIS_URL or REDIS_PRIVATE_URL is provided automatically when attaching Redis
REDIS_URL=redis://default:password@hostname:6379

# Celery broker (optional async worker tasks)
CELERY_BROKER_URL=redis://default:password@hostname:6379/1

# ------------------------------------------------------------------------------
# 4. BREVO TRANSACTIONAL EMAIL OTP AUTHENTICATION
# ------------------------------------------------------------------------------
# Brevo REST API v3 key (Required for signup / password reset email OTPs)
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=no-reply@nearbychat.in
BREVO_SENDER_NAME=Nearby Chat

# SMTP Fallback Settings (optional if using Brevo REST API)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nearby Chat <no-reply@nearbychat.in>

# ------------------------------------------------------------------------------
# 5. SMS OTP PROVIDERS (Optional / Indian mobile numbers)
# ------------------------------------------------------------------------------
# Provider choices: 'console' (dev), 'fast2sms', 'msg91', 'twilio'
OTP_PROVIDER=console
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 6. INTERNAL HEALTH & MONITORING
# ------------------------------------------------------------------------------
# Optional shared secret to view diagnostic breakdown at /health/ready/
HEALTH_CHECK_SECRET=
