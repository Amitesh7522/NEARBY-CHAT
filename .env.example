# ==============================================================================
# NEARBY CHAT ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Engine: 'sqlite' for local dev, 'postgresql' for production
DB_ENGINE=sqlite
DB_NAME=nearby_chat_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Channels Broker
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Broker (optional in local dev)
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Security & SSL (Set True in production)
SECURE_SSL_REDIRECT=False

# SMS / OTP Providers (Options for India: 'msg91', 'fast2sms', 'twilio', 'aws_sns', 'console')
# In development, leave blank or set to console/dev mode to log OTPs to console
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Settings (SMTP / SendGrid / AWS SES)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nearby Chat <no-reply@nearbychat.app>
